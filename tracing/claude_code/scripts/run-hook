#!/bin/sh
# Atatus tracing hook dispatcher.
# Called by every Claude Code hook. Bootstraps the venv on first run,
# then dispatches to the named entry point.
#
# Usage: run-hook <entry-point-name>
#   e.g. run-hook atatus-hook-session-start
#
# Requires CLAUDE_PLUGIN_ROOT and CLAUDE_PLUGIN_DATA env vars
# (set automatically by Claude Code for plugin hooks).
set -e

HOOK_NAME="${1:?usage: run-hook <entry-point-name>}"
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:?CLAUDE_PLUGIN_ROOT not set}"
DATA_DIR="${CLAUDE_PLUGIN_DATA:?CLAUDE_PLUGIN_DATA not set}"
VENV_DIR="$DATA_DIR/venv"
MARKER="$DATA_DIR/.pyproject.sha256"

# --- Find the entry point binary ---
find_entry_point() {
    if [ -x "$VENV_DIR/bin/$HOOK_NAME" ]; then
        echo "$VENV_DIR/bin/$HOOK_NAME"
    elif [ -x "$VENV_DIR/Scripts/$HOOK_NAME" ]; then
        echo "$VENV_DIR/Scripts/$HOOK_NAME"
    elif [ -x "$VENV_DIR/Scripts/${HOOK_NAME}.exe" ]; then
        echo "$VENV_DIR/Scripts/${HOOK_NAME}.exe"
    else
        return 1
    fi
}

# --- Find Python 3.9+ ---
find_python() {
    for p in python3 python py; do
        if "$p" -c "import sys; sys.exit(0 if sys.version_info>=(3,9) else 1)" 2>/dev/null; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

# --- Check if (re)install is needed ---
# Fingerprint every source file the venv installs, not just the manifest.
# pyproject.toml changes only when packaging metadata does, so a code-only update
# (new modules, rewritten handlers) left the venv serving the previously installed
# wheel forever. Stat-only: no file reads, ~1ms over the tree.
source_fingerprint() {
    "$PYTHON_CMD" - "$PLUGIN_ROOT" <<'PYEOF' 2>/dev/null
import hashlib, os, sys

root = sys.argv[1]
digest = hashlib.sha256()
for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
    dirnames[:] = sorted(d for d in dirnames if d not in {"__pycache__", ".git", ".venv"})
    for name in sorted(filenames):
        if not name.endswith(".py") and name != "pyproject.toml":
            continue
        path = os.path.join(dirpath, name)
        try:
            stat = os.stat(path)
        except OSError:
            continue
        digest.update(os.path.relpath(path, root).encode())
        digest.update(b"%d:%d" % (stat.st_size, int(stat.st_mtime)))
print(digest.hexdigest())
PYEOF
}

needs_install() {
    [ ! -d "$VENV_DIR" ] && return 0
    [ ! -f "$MARKER" ] && return 0
    current=$(source_fingerprint) || return 0
    [ -z "$current" ] && return 0
    stored=$(cat "$MARKER" 2>/dev/null) || return 0
    [ "$current" != "$stored" ]
}

# --- Bootstrap venv ---
bootstrap() {
    PYTHON_CMD=$(find_python) || {
        echo "[atatus] No Python 3.9+ found — tracing will not be available" >&2
        return 1
    }

    if ! needs_install; then
        return 0
    fi

    echo "[atatus] Setting up tracing venv..." >&2
    mkdir -p "$DATA_DIR"

    "$PYTHON_CMD" -m venv "$VENV_DIR" 2>&1 | tail -3 >&2 || {
        echo "[atatus] Failed to create venv" >&2
        return 1
    }

    # Find pip in the new venv
    PIP=""
    if [ -x "$VENV_DIR/bin/pip" ]; then PIP="$VENV_DIR/bin/pip"
    elif [ -x "$VENV_DIR/Scripts/pip" ]; then PIP="$VENV_DIR/Scripts/pip"
    elif [ -x "$VENV_DIR/Scripts/pip.exe" ]; then PIP="$VENV_DIR/Scripts/pip.exe"
    fi
    if [ -z "$PIP" ]; then
        echo "[atatus] pip not found in venv" >&2
        return 1
    fi

    echo "[atatus] Installing claude-code-tracing from $PLUGIN_ROOT..." >&2
    if ! "$PIP" install --quiet "$PLUGIN_ROOT" >&2; then
        echo "[atatus] pip install failed" >&2
        rm -f "$MARKER"
        return 1
    fi

    # Save hash marker
    source_fingerprint > "$MARKER"

    echo "[atatus] Tracing venv ready" >&2
}

# --- Main ---
# Bootstrap if needed (only does work on first run or after update)
bootstrap || exit 0

# Find and exec the entry point
EP=$(find_entry_point) || {
    echo "[atatus] Entry point '$HOOK_NAME' not found in venv" >&2
    exit 0
}

exec "$EP"
